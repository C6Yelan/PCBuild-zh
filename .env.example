# PCBuild-zh environment example
# 說明：
# - 只放範例值 / placeholder，請自行改成真實部署值。
# - 這份檔案同時服務「本機非 Docker 開發」與「伺服器 compose interpolation」。
# - REQUIRED / OPTIONAL / SERVER ONLY 只代表目前 repo 的常見使用方式。
# - 重要：伺服器 Docker 只有 docker-compose.yml 明確映射的欄位會進容器；
#   其餘欄位主要供本機非 Docker Python 執行，或未來自行擴充 compose 使用。

########################################
# App / FastAPI
########################################

# REQUIRED (SERVER ONLY for docker build)
# docker-compose.yml 會要求 APP_GIT_SHA 存在；可用 git short sha。
APP_GIT_SHA=dev-local

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
LOG_LEVEL=INFO

# OPTIONAL
# errors | all
REQUEST_LOG_MODE=errors

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
DEBUG_ROUTES_ENABLED=false

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
# 僅供 log record 顯示服務名；compose 內預設可不設。
SERVICE_NAME=fastapi

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
# crawler / pipeline log 使用的環境標記；未設時預設為 prod。
APP_ENV=prod

# OPTIONAL
# docker-compose.yml 目前已對相關服務固定注入 1；這裡主要供本機或自訂執行方式使用。
PCBUILD_LOG_TO_PID1=0

########################################
# Database
########################################

# REQUIRED
# 本機非 Docker Python 執行時可用；server compose 會以容器內 URL 覆寫。
DATABASE_URL=postgresql+psycopg2://pcbuild:CHANGE_ME@localhost:5432/pcbuild

# REQUIRED (SERVER ONLY)
POSTGRES_PASSWORD=CHANGE_ME

########################################
# Redis / Rate Limit
########################################

# REQUIRED (SERVER ONLY for compose service)
REDIS_PASSWORD=CHANGE_ME

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
RATE_LIMIT_ENABLED=true

# OPTIONAL
RATE_LIMIT_DEFAULT=300/minute

# OPTIONAL
# 本機非 Docker 預設可用 memory://；server compose 會覆寫成 redis://...
RATE_LIMIT_STORAGE_URI=memory://

########################################
# Auth / Session / Security
########################################

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
SESSION_EXPIRES_MINUTES=120

# OPTIONAL
# 逗號分隔；若使用 cookie session 的狀態變更 API，建議確實設定。
CSRF_TRUSTED_ORIGINS=https://pcbuild.redfiretw.xyz

########################################
# Email（Resend）
########################################

# OPTIONAL
# 若要使用註冊驗證信 / 忘記密碼 / 密碼變更通知，以下欄位需補齊。
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY

# OPTIONAL
RESEND_FROM_EMAIL=no-reply@example.com

# OPTIONAL
RESEND_FROM_NAME=PCBuild

# OPTIONAL
RESEND_REGION=

########################################
# AI / Chat provider
########################################

# REQUIRED
# allowed: openai_compat | local_openai_compat | backup_openai_compat | gemini
# 目前正式驗收主線建議維持 openai_compat。
AI_PROVIDER=openai_compat

# REQUIRED
AI_MODEL=REPLACE_WITH_PROVIDER_MODEL

# REQUIRED
AI_TIMEOUT_SECONDS=30

# REQUIRED
AI_MAX_OUTPUT_CHARS=4000

# REQUIRED for openai-compatible providers
AI_OAI_BASE_URL=https://api.openai.com/v1

# OPTIONAL / SECRET
# 若上游需要授權，請填入實際 key。
AI_OAI_API_KEY=REPLACE_WITH_OPENAI_COMPAT_API_KEY

# OPTIONAL
# 本機非 Docker 可改成專案相對路徑；server compose 會覆寫為 /app/data/ai_raw_snapshots
AI_RAW_SNAPSHOT_DIR=./data/ai_raw_snapshots

# OPTIONAL
# 僅在 AI_PROVIDER=gemini 時需要至少填一個。
GEMINI_API_KEY=

# OPTIONAL
# 若同時有 GOOGLE_API_KEY 與 GEMINI_API_KEY，程式會優先用 GOOGLE_API_KEY。
GOOGLE_API_KEY=

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
P2_MAX_VALUE_LEN=120

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
P2_MAX_SPECS_PER_PART=12

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
# JSON string；留空表示使用程式內建 whitelist。
P2_SPEC_WHITELIST_BY_CATEGORY=

########################################
# Crawler / Catalog
########################################

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
PCBUILD_CRAWLER_USER_AGENT=pcbuild-zh-crawler/0.1 (+contact: admin@example.com)

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
PCBUILD_CRAWLER_TIMEOUT_SECONDS=15.0

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
PCBUILD_CRAWLER_MAX_REDIRECTS=5

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
PCBUILD_CRAWLER_CONNECT_RETRIES=2

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
PCBUILD_CRAWLER_RESPECT_ROBOTS_TXT=true

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
PCBUILD_CRAWLER_POLITENESS_DELAY_SECONDS=1.0

# OPTIONAL (LOCAL NON-DOCKER unless compose is extended)
PCBUILD_CRAWLER_ROBOTS_CACHE_TTL_SECONDS=3600

########################################
# Typesense
########################################

# OPTIONAL
# false: 一律走 PostgreSQL retrieval
# true: 先走 Typesense，失敗時 fallback 到 PostgreSQL
TYPESENSE_ENABLED=false

# OPTIONAL
TYPESENSE_HOST=typesense

# OPTIONAL
TYPESENSE_PORT=8108

# OPTIONAL
TYPESENSE_PROTOCOL=http

# REQUIRED when TYPESENSE_ENABLED=true
TYPESENSE_API_KEY=CHANGE_ME

# OPTIONAL
TYPESENSE_COLLECTION_PARTS=parts

# OPTIONAL
TYPESENSE_TIMEOUT_SECONDS=2.0

########################################
# Observability / Grafana
########################################

# OPTIONAL (SERVER ONLY)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# OPTIONAL (SERVER ONLY)
# Grafana SMTP 使用 Resend SMTP 時需要。
RESEND_SMTP_API_KEY=CHANGE_ME

# OPTIONAL (SERVER ONLY)
GRAFANA_SMTP_FROM_ADDRESS=alerts@example.com
