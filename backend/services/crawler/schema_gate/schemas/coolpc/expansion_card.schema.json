{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Location: backend/services/crawler/schema_gate/schemas/coolpc/expansion_card.schema.json",
  "title": "CoolPC EXPANSION_CARD ListingCandidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "price", "currency", "category", "url", "sku_hint", "extra"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "price": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "const": "TWD" },
    "category": { "type": "string", "const": "EXPANSION_CARD" },
    "url": { "type": "string", "minLength": 1, "format": "uri" },
    "sku_hint": { "type": "string", "minLength": 1 },

    "extra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand_hint", "model_hint", "card_kind_hint", "host_bus_hint"],
      "properties": {
        "brand_hint": { "type": "string", "minLength": 1 },
        "model_hint": { "type": "string", "minLength": 1 },

        "card_kind_hint": {
          "type": "string",
          "enum": ["m2_adapter", "thunderbolt", "usb4", "usb", "sata", "serial", "parallel"]
        },

        "host_bus_hint": { "type": "string", "enum": ["pcie"] },

        "pcie_gen_hint": { "type": "integer", "enum": [3, 4, 5] },
        "pcie_lanes_hint": { "type": "integer", "enum": [1, 2, 4, 8, 16] },

        "m2_slot_count_hint": { "type": "integer", "minimum": 1, "maximum": 16 },
        "nvme_only_hint": { "type": "boolean" },

        "thunderbolt_port_count_hint": { "type": "integer", "minimum": 1, "maximum": 8 },
        "usb4_port_count_hint": { "type": "integer", "minimum": 1, "maximum": 8 },

        "usb_typea_port_count_hint": { "type": "integer", "minimum": 1, "maximum": 32 },
        "usb_typec_port_count_hint": { "type": "integer", "minimum": 1, "maximum": 32 },

        "sata_port_count_hint": { "type": "integer", "minimum": 1, "maximum": 32 },

        "parallel_port_count_hint": { "type": "integer", "minimum": 1, "maximum": 8 },
        "rs232_port_count_hint": { "type": "integer", "minimum": 1, "maximum": 32 },

        "displayport_in_count_hint": { "type": "integer", "minimum": 0, "maximum": 8 },
        "mini_dp_in_count_hint": { "type": "integer", "minimum": 0, "maximum": 8 },

        "bandwidth_gbps_hint": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "chipset_hint": { "type": "string", "minLength": 1 },

        "low_profile_bracket_included_hint": { "type": "boolean" },
        "internal_header_hint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:主板\\s*20Pin\\s*Type-?C|20Pin\\s*Type-?C|USB\\s*19\\s*pin|USB19pin|19Pin|20Pin)$"
        },

        "is_bundle": { "type": "boolean" },
        "is_accessory": { "type": "boolean" }
      },

      "allOf": [
        {
          "if": { "properties": { "card_kind_hint": { "const": "m2_adapter" } }, "required": ["card_kind_hint"] },
          "then": { "required": ["pcie_lanes_hint", "m2_slot_count_hint"] }
        },
        {
          "if": { "properties": { "card_kind_hint": { "const": "thunderbolt" } }, "required": ["card_kind_hint"] },
          "then": { "required": ["pcie_lanes_hint", "thunderbolt_port_count_hint", "mini_dp_in_count_hint", "bandwidth_gbps_hint"] }
        },
        {
          "if": { "properties": { "card_kind_hint": { "const": "usb4" } }, "required": ["card_kind_hint"] },
          "then": { "required": ["pcie_lanes_hint", "usb4_port_count_hint", "displayport_in_count_hint"] }
        },
        {
          "if": { "properties": { "card_kind_hint": { "const": "sata" } }, "required": ["card_kind_hint"] },
          "then": { "required": ["sata_port_count_hint"] }
        },
        {
          "if": { "properties": { "card_kind_hint": { "const": "parallel" } }, "required": ["card_kind_hint"] },
          "then": { "required": ["parallel_port_count_hint"] }
        },
        {
          "if": { "properties": { "card_kind_hint": { "const": "serial" } }, "required": ["card_kind_hint"] },
          "then": { "required": ["rs232_port_count_hint"] }
        }
      ]
    }
  }
}
