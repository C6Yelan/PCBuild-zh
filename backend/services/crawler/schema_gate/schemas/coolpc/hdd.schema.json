{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Location: backend/services/crawler/schema_gate/schemas/coolpc/hdd.schema.json",
  "title": "CoolPC HDD ListingCandidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "price", "currency", "category", "url", "sku_hint", "extra"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "price": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "const": "TWD" },
    "category": { "type": "string", "const": "HDD" },
    "url": { "type": "string", "minLength": 1, "format": "uri" },
    "sku_hint": { "type": "string", "minLength": 1 },

    "extra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand_hint", "model_hint", "capacity_gib"],
      "properties": {
        "brand_hint": { "type": "string", "minLength": 1 },
        "model_hint": { "type": "string", "minLength": 1 },

        "capacity_gib": { "type": "integer", "minimum": 1 },

        "segment_hint": {
          "type": "string",
          "enum": ["Desktop", "NAS", "Surveillance", "Enterprise", "Mobile"]
        },
        "series_hint": { "type": "string", "minLength": 1 },

        "form_factor_hint": { "type": "string", "enum": ["2.5\"", "3.5\""] },
        "thickness_mm_hint": { "type": "number", "minimum": 0 },

        "interface_hint": { "type": "string", "enum": ["SATA", "SAS", "USB"] },

        "rpm_hint": { "type": "integer", "minimum": 1 },
        "cache_mb_hint": { "type": "integer", "minimum": 0 },

        "warranty_years": { "type": "integer", "minimum": 0 },
        "rescue_years": { "type": "integer", "minimum": 0 },

        "limit_hint": { "type": "string", "minLength": 1 }
      }
    }
  }
}
