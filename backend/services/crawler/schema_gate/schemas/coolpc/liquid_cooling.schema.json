{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Location: backend/services/crawler/schema_gate/schemas/coolpc/liquid_cooling.schema.json",
  "title": "CoolPC LIQUID_COOLING ListingCandidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "price", "currency", "category", "url", "sku_hint", "extra"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "price": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "const": "TWD" },
    "category": { "type": "string", "const": "LIQUID_COOLING" },
    "url": { "type": "string", "minLength": 1, "format": "uri" },
    "sku_hint": { "type": "string", "minLength": 1 },

    "extra": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "brand_hint",
        "model_hint",
        "radiator_size_mm_hint",
        "warranty_years",
        "is_bundle",
        "is_accessory"
      ],

      "properties": {
        "brand_hint": { "type": "string", "minLength": 1 },
        "model_hint": { "type": "string", "minLength": 1 },

        "radiator_size_mm_hint": {
          "type": "integer",
          "enum": [120, 240, 280, 360, 420]
        },

        "warranty_years": { "type": "integer", "minimum": 1, "maximum": 10 },

        "is_bundle": { "type": "boolean" },
        "is_accessory": { "type": "boolean" },

        "radiator_thickness_mm_hint": { "type": "integer", "minimum": 20, "maximum": 100 },

        "rgb_hint": { "type": "string", "enum": ["rgb", "argb", "d-rgb"] },

        "lcd_size_inch_hint": { "type": "number", "minimum": 1.0, "maximum": 10.0 },

        "socket_support_hint": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
